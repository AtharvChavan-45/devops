pipeline {
    agent any

    environment {
        // Docker Hub repository coordinates (Update with your Docker Hub username)
        DOCKER_HUB_USER    = 'atharvpatil'
        IMAGE_NAME         = 'devops-student-management'
        DOCKER_IMAGE       = "${DOCKER_HUB_USER}/${IMAGE_NAME}"
        BUILD_TAG          = "${env.BUILD_NUMBER}"
        LATEST_TAG         = "latest"
        
        // Jenkins Credentials ID configured in Manage Jenkins -> Credentials
        DOCKER_CREDENTIALS = 'dockerhub-credentials-id'
    }

    tools {
        // Automatically configures Maven tool defined in Jenkins Global Tool Configuration
        maven 'Maven-3.9.6'
        jdk   'JDK-17'
    }

    stages {
        // ----------------------------------------------------------------------
        // STAGE 1: Source Code Checkout
        // ----------------------------------------------------------------------
        stage('Checkout Code') {
            steps {
                echo "========== STAGE 1: Checking out code from GitHub =========="
                checkout scm
                sh 'git log -1 --pretty=format:"Commit: %h - %an: %s"'
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 2: Automated Unit Testing
        // ----------------------------------------------------------------------
        stage('Run Unit Tests') {
            steps {
                echo "========== STAGE 2: Running Automated JUnit 5 Tests =========="
                sh 'mvn test'
            }
            post {
                always {
                    // Archive Surefire test results for Jenkins test graphs
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 3: Build & Package Artifact (Fat JAR)
        // ----------------------------------------------------------------------
        stage('Build & Package JAR') {
            steps {
                echo "========== STAGE 3: Packaging Spring Boot Executable JAR =========="
                sh 'mvn clean package -DskipTests'
                sh 'ls -lh target/*.jar'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 4: Build Docker Image
        // ----------------------------------------------------------------------
        stage('Build Docker Image') {
            steps {
                echo "========== STAGE 4: Building Docker Container Image =========="
                sh """
                    docker build -t ${DOCKER_IMAGE}:${BUILD_TAG} -t ${DOCKER_IMAGE}:${LATEST_TAG} .
                    docker images | grep ${IMAGE_NAME}
                """
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 5: Push Image to Docker Hub Registry
        // ----------------------------------------------------------------------
        stage('Push to Docker Hub') {
            steps {
                echo "========== STAGE 5: Pushing Image to Docker Hub =========="
                // Securely inject Docker Hub credentials without exposing secrets in logs
                withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                        docker push ${DOCKER_IMAGE}:${BUILD_TAG}
                        docker push ${DOCKER_IMAGE}:${LATEST_TAG}
                    """
                }
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 6: Deploy Application (Kubernetes / Docker Compose)
        // ----------------------------------------------------------------------
        stage('Deploy Application') {
            steps {
                echo "========== STAGE 6: Deploying to Kubernetes Cluster =========="
                script {
                    // Update Kubernetes deployment image dynamically with the current build tag
                    sh """
                        kubectl set image deployment/student-management-deployment student-app=${DOCKER_IMAGE}:${BUILD_TAG} --record || kubectl apply -f k8s/
                        kubectl rollout status deployment/student-management-deployment --timeout=60s
                    """
                }
            }
        }

        // ----------------------------------------------------------------------
        // STAGE 7: Smoke Test & Health Check
        // ----------------------------------------------------------------------
        stage('Smoke Test') {
            steps {
                echo "========== STAGE 7: Verifying Application Health =========="
                sh """
                    sleep 5
                    curl -s -f http://localhost:8080/api/students/health || echo 'Verify NodePort or Service IP if testing outside cluster'
                """
            }
        }
    }

    // --------------------------------------------------------------------------
    // Post-Build Pipeline Execution Actions
    // --------------------------------------------------------------------------
    post {
        always {
            echo "========== Pipeline Execution Finished =========="
            // Clean up workspace to save disk space
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success {
            echo "SUCCESS: CI/CD Pipeline built, containerized, and deployed successfully!"
        }
        failure {
            echo "FAILURE: Pipeline execution failed! Check console logs for debugging."
        }
    }
}
